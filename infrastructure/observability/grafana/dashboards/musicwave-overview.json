      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [{"editorMode": "code", "expr": "sum by (application, status) (rate(http_server_requests_seconds_count[5m]))", "legendFormat": "{{application}} {{status}}", "range": true, "refId": "A"}],
