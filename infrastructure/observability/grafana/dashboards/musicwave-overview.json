      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [{"editorMode": "code", "expr": "sum by (outcome) (rate(musicwave_rate_limit_requests_total[5m]))", "legendFormat": "{{outcome}}", "range": true, "refId": "A"}],
