---
interface Props {
  id?: string;
  variant?: 'info' | 'success' | 'warning' | 'error';
  title?: string;
  dismissible?: boolean;
  class?: string;
}

const {
  id,
  variant = 'info',
  title,
  dismissible = false,
  class: className = '',
} = Astro.props;

const role = variant === 'error' || variant === 'warning' ? 'alert' : 'status';

const variantClasses = {
  info: 'bg-sky-950/70 border-sky-800 text-sky-200',
  success: 'bg-emerald-950/70 border-emerald-800 text-emerald-200',
  warning: 'bg-amber-950/70 border-amber-800 text-amber-200',
  error: 'bg-red-950/70 border-red-800 text-red-200',
}[variant];

const iconMap = {
  info: 'ℹ️',
  success: '✅',
  warning: '⚠️',
  error: '❌',
};
---

<div
  id={id}
  role={role}
  class:list={[
    'relative flex gap-3 p-4 rounded-lg border text-sm transition-all shadow-sm',
    variantClasses,
    className,
  ]}
>
  <div class="text-base shrink-0 select-none" aria-hidden="true">
    {iconMap[variant]}
  </div>

  <div class="flex-1 space-y-1">
    {title && <h3 class="font-semibold tracking-wide text-white">{title}</h3>}
    <div class="text-slate-300 leading-relaxed">
      <slot />
    </div>
  </div>

  {
    dismissible && (
      <button
        type="button"
        class="text-slate-400 hover:text-white transition-colors p-1 -mr-1 -mt-1 rounded focus:outline-none focus:ring-2 focus:ring-blue-400 cursor-pointer"
        aria-label="Descartar alerta"
        onclick="this.closest('[role=alert], [role=status]').remove()"
      >
        <span aria-hidden="true">&times;</span>
      </button>
    )
  }
</div>
