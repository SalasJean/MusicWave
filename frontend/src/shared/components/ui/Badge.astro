---
interface Props {
  variant?:
    | 'default'
    | 'pending'
    | 'queued'
    | 'downloading'
    | 'converting'
    | 'completed'
    | 'failed'
    | 'cancelled';
  size?: 'sm' | 'md';
  dot?: boolean;
  class?: string;
}

const {
  variant = 'default',
  size = 'md',
  dot = false,
  class: className = '',
} = Astro.props;

const sizeClasses = {
  sm: 'text-xs px-2 py-0.5 gap-1',
  md: 'text-xs px-2.5 py-1 gap-1.5 font-medium',
}[size];

const variantClasses = {
  default: 'bg-slate-800 text-slate-300 border border-slate-700',
  pending: 'bg-slate-800/80 text-slate-300 border border-slate-700',
  queued: 'bg-sky-950/80 text-sky-400 border border-sky-800',
  downloading: 'bg-emerald-950/80 text-emerald-400 border border-emerald-800',
  converting: 'bg-amber-950/80 text-amber-400 border border-amber-800',
  completed: 'bg-green-950/80 text-green-400 border border-green-800',
  failed: 'bg-red-950/80 text-red-400 border border-red-800',
  cancelled: 'bg-slate-900 text-slate-500 border border-slate-800 line-through',
}[variant];

const dotClasses = {
  default: 'bg-slate-400',
  pending: 'bg-slate-400 animate-pulse',
  queued: 'bg-sky-400',
  downloading: 'bg-emerald-400 animate-pulse',
  converting: 'bg-amber-400 animate-pulse',
  completed: 'bg-green-400',
  failed: 'bg-red-400',
  cancelled: 'bg-slate-500',
}[variant];
---

<span
  class:list={[
    'inline-flex items-center rounded-full tracking-wide select-none',
    sizeClasses,
    variantClasses,
    className,
  ]}
>
  {
    dot && (
      <span
        class:list={['w-1.5 h-1.5 rounded-full shrink-0', dotClasses]}
        aria-hidden="true"
      />
    )
  }
  <slot />
</span>
