---
import AppLayout from '@/layouts/AppLayout.astro';
import SettingsForm from '@/features/settings/components/SettingsForm.astro';
---

<AppLayout title="Ajustes">
  <div class="space-y-6 max-w-4xl">
    <div class="border-b border-slate-800 pb-4">
      <h1 class="text-2xl font-bold tracking-tight text-white">
        Ajustes de Usuario
      </h1>
      <p class="mt-1 text-sm text-slate-400">
        Configuración de concurrencia y calidad de audio persistida en el
        servidor para todas las descargas.
      </p>
    </div>

    <!-- Formulario interactivo de ajustes con sincronización REST -->
    <SettingsForm />
  </div>
</AppLayout>
