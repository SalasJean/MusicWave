{
  "name": "musicwave-frontend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "generate:types": "openapi-typescript ../docs/openapi/musicwave-api-v1.json -o src/generated/api-schema.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.3.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
